#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_STM32F407_HEALTH

config STM32F4DISBB
	bool "STM32F4DIS-BB base board"
	default n
	---help---
		Select if you are using the STM32F4DIS-BB base board with the
		STM32F407_health.

config STM32_ROMFS
	bool "Automount baked-in ROMFS image"
	default n
	depends on FS_ROMFS
	---help---
		Select STM32_ROMFS_IMAGEFILE, STM32_ROMFS_DEV_MINOR, STM32_ROMFS_MOUNTPOINT

config STM32_ROMFS_DEV_MINOR
	int "Minor for the block device backing the data"
	depends on STM32_ROMFS
	default 64

config STM32_ROMFS_MOUNTPOINT
	string "Mountpoint of the custom romfs image"
	depends on STM32_ROMFS
	default "/rom"

config STM32_ROMFS_IMAGEFILE
	string "ROMFS image file to include into build"
	depends on STM32_ROMFS
	default "../../../../../rom.img"

config STM32F4DISCO_USBHOST_STACKSIZE
	int "USB host waiter stack size"
	default 1024
	depends on USBHOST

config STM32F4DISCO_USBHOST_PRIO
	int "USB host waiter task priority"
	default 100
	depends on USBHOST

config STM32F4DISCO_QETIMER
	int "Timer to use with QE encoder"
	default 2
	depends on SENSORS_QENCODER

config STM32F4DISCO_TIMER
	int "Timer to use with timer driver"
	default 4
	depends on TIMER

config STM32F4DISCO_LIS3DSH
	bool "Enable LIS3DSH driver for the IMU on STM32F407_health (rev. MB997C)"
	default n
	depends on SPI
	depends on LIS3DSH
	default n
	select SENSORS_LIS3DSH
	---help---
		Select to create a LIS3DSH driver instance for the builtin accelerometer of
		STM32F407_health. Provides /dev/acc0 device file.
		Also see apps/examples/lis3dsh_reader.
		The LIS3DSH is available on the STM32F407_health rev. MB997C (see the board manual).

config PM_BUTTONS
	bool "PM button support"
	default n
	depends on PM && ARCH_IRQBUTTONS
	---help---
		Enable PM button EXTI interrupts to support PM testing

config PM_BUTTON_ACTIVITY
	int "Button PM activity weight"
	default 10
	depends on PM_BUTTONS
	---help---
		The activity weight to report to the power management subsystem when
		a button is pressed.

config PM_ALARM_SEC
	int "PM_STANDBY delay (seconds)"
	default 15
	depends on PM && RTC_ALARM
	---help---
		Number of seconds to wait in PM_STANDBY before going to PM_STANDBY
		mode.

config PM_ALARM_NSEC
	int "PM_STANDBY delay (nanoseconds)"
	default 0
	depends on PM && RTC_ALARM
	---help---
		Number of additional nanoseconds to wait in PM_STANDBY before going
		to PM_STANDBY mode.

config PM_SLEEP_WAKEUP
	bool "PM_SLEEP wake-up alarm"
	default n
	depends on PM && RTC_ALARM
	---help---
		Wake-up of PM_SLEEP mode after a delay and resume normal operation.

config PM_SLEEP_WAKEUP_SEC
	int "PM_SLEEP delay (seconds)"
	default 10
	depends on PM && RTC_ALARM
	---help---
		Number of seconds to wait in PM_SLEEP before going to PM_STANDBY mode.

config PM_SLEEP_WAKEUP_NSEC
	int "PM_SLEEP delay (nanoseconds)"
	default 0
	depends on PM && RTC_ALARM
	---help---
		Number of additional nanoseconds to wait in PM_SLEEP before going to
		PM_STANDBY mode.

config SENSORS_LD2410B
	bool "LD2410B 毫米波雷达传感器"
	default n
	depends on UART2
	---help---
		启用 LD2410B 毫米波雷达传感器驱动。
		LD2410B 是一款人体存在检测传感器，通过 USART2 连接。

config ESP32S3_UART
	bool "ESP32-S3 串口通信支持"
	default n
	depends on SERIAL
	---help---
		启用 ESP32-S3 串口通信支持。
		通过 USART3 连接 ESP32-S3-N16R8：
		PB10 (USART3_TX) → GPIO18 (U1RXD)
		PB11 (USART3_RX) → GPIO17 (U1TXD)
		波特率：115200

config SENSORS_SHT30
	bool "SHT30 温湿度传感器"
	default n
	depends on I2C
	---help---
		启用 SHT30 温湿度传感器驱动。
		通过 I2C1 连接：
		PB6 (I2C1_SCL) → SCL
		PB9 (I2C1_SDA) → SDA
		地址：0x44

config SENSORS_VL53L0X
	bool "VL53L0X 激光测距传感器"
	default n
	depends on I2C
	---help---
		启用 VL53L0X 激光测距传感器驱动。
		通过 I2C1 连接：
		PB6 (I2C1_SCL) → SCL
		PB9 (I2C1_SDA) → SDA
		地址：0x29
		XSHUT: PC5 (GPIO控制)
		GPIO1: PC4 (中断输出)

config LCD_GC9A01
	bool "GC9A01 圆形 TFT LCD"
	default n
	depends on SPI
	depends on SPI_CMDDATA
	depends on LCD
	select FB_UPDATE
	select LCD_FRAMEBUFFER
	---help---
		启用 GC9A01 圆形 TFT LCD 显示驱动。
		通过 SPI1 连接（非默认引脚）：
		PB3 (SPI1_SCK)
		PB5 (SPI1_MOSI)
		DC: PD7 (数据/命令)
		RST: PA4 (硬件复位)
		CS: 未接（低电平有效，直接接地）

config STATUS_LED
	bool "状态指示灯 (PD0/PD1/PE6)"
	default n
	---help---
		启用 3 路状态指示灯：
		PD0 — 在位指示灯 (LED_PRESENCE)
		PD1 — 告警指示灯 (LED_ALERT)
		PE6 — 蓝牙连接指示灯 (LED_BLE)

endif
