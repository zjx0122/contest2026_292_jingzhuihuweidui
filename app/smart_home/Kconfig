# app/smart_home/Kconfig
# 智能家居应用配置

config PACKAGES_DEMOS_SMART_HOME
	bool "Smart Home Application"
	default n
	depends on ARCH_CHIP_STM32F407VG
	---help---
		Enable the smart home application for STM32F407VGT6.
		Includes GC9A01 display, SHT30, VL53L0X, LD2410B radar,
		SU-03T voice, BLE communication.

if PACKAGES_DEMOS_SMART_HOME

config PACKAGES_DEMOS_SMART_HOME_PROGNAME
	string "Program name"
	default "smart_home"
	---help---
		Command name shown in NuttShell (NSH).

config PACKAGES_DEMOS_SMART_HOME_PRIORITY
	int "Task priority"
	default 100

config PACKAGES_DEMOS_SMART_HOME_STACKSIZE
	int "Task stack size"
	default 4096

endif # PACKAGES_DEMOS_SMART_HOME