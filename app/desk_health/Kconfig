config EXAMPLES_DESK_HEALTH
	tristate "Desktop Health Monitor Example"
	default n
	---help---
		Enable the Desktop Health Monitor application for OpenVela.

if EXAMPLES_DESK_HEALTH

config EXAMPLES_DESK_HEALTH_PROGNAME
	string "Program name"
	default "desk_health"

config EXAMPLES_DESK_HEALTH_PRIORITY
	int "Desk Health task priority"
	default 100

config EXAMPLES_DESK_HEALTH_STACKSIZE
	int "Desk Health stack size"
	default 2048

config DESK_HEALTH_ESP32
	bool "ESP32-S3 通信任务"
	default n
	depends on ESP32S3_UART
	---help---
		启用 ESP32-S3 通信任务。
		功能：发送传感器数据到 ESP32-S3，接收控制命令。

endif